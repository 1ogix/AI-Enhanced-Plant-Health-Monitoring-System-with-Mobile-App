# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

# This helps with Firebase module conflicts
install! 'cocoapods', :deterministic_uuids => false
require 'fileutils'

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  # CocoaPods default linkage (no use_frameworks!) keeps Flutter engine integration stable
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    target.build_configurations.each do |config|
      # Required minimum iOS version
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
      
      # Critical settings for Firebase non-modular header includes
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      config.build_settings['DEFINES_MODULE'] = 'YES'
      config.build_settings['APPLICATION_EXTENSION_API_ONLY'] = 'NO'
      
      # Allow warnings for firebase modules to suppress the non-modular includes errors
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES' if target.name.include? 'Firebase'
      config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES' if target.name.include? 'Firebase'
      
      # Architecture settings
      if config.name == 'Debug'
        config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'
      else
        config.build_settings['ONLY_ACTIVE_ARCH'] = 'NO'
      end
      
      # Disable pod framework code signing for simulator builds
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
      config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
      
      # NEW ADDITIONS - Critical for fixing module redefinition errors
      config.build_settings["EXCLUDED_ARCHS[sdk=iphonesimulator*]"] = "arm64"
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      config.build_settings['DEAD_CODE_STRIPPING'] = 'YES'
      
      # Explicitly set modulemap path for Firebase
      if target.name.include? 'Firebase'
        config.build_settings['SWIFT_INCLUDE_PATHS'] = '$(inherited) "${PODS_ROOT}/Firebase/CoreOnly/Sources"'
        config.build_settings['HEADER_SEARCH_PATHS'] = '$(inherited) "${PODS_ROOT}/Firebase/CoreOnly/Sources"'
      end

      # Ensure FirebaseAuth can locate its private headers when building as modular headers
      if target.name == 'FirebaseAuth'
        existing_paths = config.build_settings['HEADER_SEARCH_PATHS'] || '$(inherited)'
        extra_paths = ' "${PODS_ROOT}/Headers/Private" "${PODS_ROOT}/FirebaseAuth" "${PODS_ROOT}/FirebaseAuth/FirebaseAuth/Sources"'
        config.build_settings['HEADER_SEARCH_PATHS'] = existing_paths + extra_paths
      end
    end
  end

  # Strip problematic macOS extended attributes that break codesign
  system('find Pods -type d -name "*.framework" -print0 | xargs -0 xattr -rc >/dev/null 2>&1')

  sandbox_root = installer.respond_to?(:sandbox_root) ? installer.sandbox_root : installer.sandbox.root.to_path
  firebase_auth_sources = File.join(sandbox_root, 'FirebaseAuth', 'FirebaseAuth')
  legacy_sources = File.join(firebase_auth_sources, 'Sources 2')
  canonical_sources = File.join(firebase_auth_sources, 'Sources')
  if File.directory?(legacy_sources) && File.directory?(canonical_sources)
    Dir.glob(File.join(legacy_sources, '*')).each do |legacy_entry|
      destination = File.join(canonical_sources, File.basename(legacy_entry))
      FileUtils.rm_rf(destination)
      FileUtils.mv(legacy_entry, destination)
    end
    FileUtils.rm_rf(legacy_sources)
  end
end
